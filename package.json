{
  "name": "discord-invite-tracker-bot",
  "version": "1.0.0",
  "description": "Discord invite tracker + dynamic rewards bot with image progress cards and a full admin panel.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
